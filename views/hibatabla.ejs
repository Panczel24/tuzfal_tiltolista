<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hibatabla</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <a href="/">index</a>

    <table>
        <thead>

            <tr>
                <td>Priority</td>
                <td>Mac</td>
                <td>Enabled</td>
            </tr>
        </thead>
        <tbody>
            <% for( hiba of hibak ) { %>
            <tr>
                <td><%= hiba.id %></td>
                <td><%= hiba.priority %></td>
                <td><%= hiba.mac %></td>
                <td><%= hiba.enabled %></td>
            </tr>
            <% } %>
        </tbody>
    </table>
    
</body>
</html>